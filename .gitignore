node_modules/
.next/
out/
dist/
*.tsbuildinfo
.cache/

# Secrets never enter the repo. Real values live in .env.local (dev) or the
# host's env (prod). .env.example is the only committed env file.
.env
.env.*
!.env.example

# Development mail transport. Every message the app "sends" without a Resend
# key lands here, so it holds live sign-in links and speaker addresses.
.mail/

# Agent notes for one machine: absolute paths, a tailnet hostname and that
# node's inbound port allowlist. The published CLAUDE.md holds everything
# portable, and this holds the rest so a public repo does not carry a map of
# somebody's private network.
CLAUDE.local.md

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Speaker uploads. Real files on this machine's disk, served by /files/<id>.
# Headshots, slide decks, posters and supporting documents belong to the people
# who sent them and are not repository content.
/uploads/
