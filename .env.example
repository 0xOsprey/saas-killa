# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Postgres. `pnpm db:up` starts a local one matching this URL.
# Production: the connection string from Supabase or Neon.
DATABASE_URL=postgres://saaskilla:saaskilla@127.0.0.1:5433/saaskilla

# Signs the session cookie. Any random 32+ byte string.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Absolute base URL, used to build magic-link and decision-email links.
APP_URL=http://127.0.0.1:9140

# Transactional email. Leave RESEND_API_KEY unset in development and every
# outbound message is written to stdout and to .mail/ instead of being sent.
RESEND_API_KEY=
MAIL_FROM="Saas Killa <cfp@example.com>"

# on | off, and nothing else parses. `off` keeps a real RESEND_API_KEY in place
# but routes every notification to .mail/ instead of sending it, so an organizer
# screen can be clicked through without paying for a send per press or bouncing
# mail off the seeded @example.com addresses. Sign-in links are exempt, so the
# instance stays one you can log in to.
MAIL_NOTIFICATIONS=on

# Bootstrap organizer. On seed, this address is granted the organizer role so
# there is a way into the admin screens on a fresh database.
BOOTSTRAP_ORGANIZER_EMAIL=organizer@example.com

# The AI evaluator. Unset means off: the organizer screens say so, no request is
# made, and every grade on a submission is a human's. Set it and the evaluator
# gets a `users` row with the reviewer role and writes ordinary `reviews` rows
# tagged `source: 'ai'`. It still never decides; a human accepts or rejects.
ANTHROPIC_API_KEY=

# The one-way push to Accelevents. Leave all three unset and every export is a
# dry run: each request is built and checked against a recorded copy of what
# Accelevents accepts, and nothing leaves the machine. All three set is the only
# state that reaches a real event, so set them together or not at all.
ACCELEVENTS_BASE_URL=
ACCELEVENTS_API_KEY=
ACCELEVENTS_EVENT_ID=

# Demo / admin mode. `off` hides the demo page and role switcher.
# `open` shows one-click role buttons on /demo (local/dev only).
# `secret` requires DEMO_SECRET and shows a password field on /demo.
# DEMO_SECRET must be 32+ characters. Keep it out of the repo.
DEMO_MODE=off
DEMO_SECRET=
