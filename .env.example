# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Postgres. `pnpm db:up` starts a local one matching this URL.
# Production: the connection string from Supabase or Neon.
DATABASE_URL=postgres://sessionboard:sessionboard@127.0.0.1:5433/sessionboard

# Signs the session cookie. Any random 32+ byte string.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Absolute base URL, used to build magic-link and decision-email links.
APP_URL=http://127.0.0.1:9140

# Transactional email. Leave RESEND_API_KEY unset in development and every
# outbound message is written to stdout and to .mail/ instead of being sent.
RESEND_API_KEY=
MAIL_FROM="Sessionboard <cfp@example.com>"

# Bootstrap organizer. On seed, this address is granted the organizer role so
# there is a way into the admin screens on a fresh database.
BOOTSTRAP_ORGANIZER_EMAIL=organizer@example.com
